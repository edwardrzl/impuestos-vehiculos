JWT_SECRET=

# Clave de la API de Google Gemini. Se usa para validar automáticamente
# con visión artificial las fotos de las tarjetas de propiedad en las
# solicitudes de traspaso, y para el asistente de chat (/api/chat).
# Si se deja vacía, el servidor arranca igual pero esos endpoints
# responden 503 al intentar usarse.
# Obtener gratis en https://aistudio.google.com
GEMINI_API_KEY=

# Opcional: modelo de Gemini para el asistente de chat (por defecto
# gemini-3.1-flash-lite). Útil si la cuota gratuita diaria del modelo se agota.
# GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
