JWT_SECRET=

# Clave de la API de Google Gemini para el asistente de chat (/api/chat).
# Si se deja vacía, el servidor arranca igual pero el endpoint responde 503.
# Obtener gratis en https://aistudio.google.com
GEMINI_API_KEY=

# Clave de Gemini para la validación de fotos de traspaso. Independiente de la
# del chat: puede ser de otro proyecto de Google para aislar la cuota gratuita.
# Sin clave, POST /api/traspasos/solicitar responde 503.
GEMINI_VALIDATION_API_KEY=

# Opcional: modelos por feature (defaults en src/config.ts)
# GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
# GEMINI_VALIDATION_MODEL=gemini-3.1-flash-lite
